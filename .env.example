GATEWAY_PORT=8080
PARTNER_PORT=8081
MYSQL_PORT=3306
PROMETHEUS_PORT=9090
# Local demo credentials only. Replace with managed secrets outside local use.
MYSQL_PASSWORD=integration_local_only
# Docker Compose defaults this automatically. Set it only when your local
# MySQL administrative account requires a password.
# MYSQL_ROOT_PASSWORD=
PARTNER_RATE_LIMIT=10
PARTNER_RETRY_MAX_ATTEMPTS=3

# Native cluster scripts (docs/local-cluster.md)
# MYSQL_HOST=127.0.0.1
# MYSQL_DATABASE=integration_lab
# MYSQL_USER=integration
# MYSQL_ROOT_USER=root
# SPRING_PROFILE=demo
